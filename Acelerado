<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pizzaria Acelerado - Cardápio & Pedidos</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .active-tab {
            border-bottom: 3px solid #dc2626;
            color: #dc2626;
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-gray-100 font-sans min-h-screen flex flex-col justify-between">

    <!-- Header -->
    <header class="bg-red-600 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-black tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-pizza-slice"></i> PIZZARIA ACELERADO
                </h1>
                <p class="text-xs text-red-100 flex items-center gap-1 mt-1">
                    <i class="fa-solid fa-location-dot"></i> Rua Mestre Vitalino, 273 - Alto do Moura, Caruaru - PE
                </p>
            </div>
            <button onclick="openCart()" class="relative bg-white text-red-600 px-4 py-2 rounded-full font-bold shadow-lg hover:bg-red-50 transition">
                <i class="fa-solid fa-cart-shopping"></i>
                <span id="cart-count" class="bg-yellow-500 text-black text-xs px-2 py-0.5 rounded-full font-bold ml-1">0</span>
            </button>
        </div>
    </header>

    <!-- Banner Informativo -->
    <section class="bg-yellow-500 text-black py-2 text-center text-xs sm:text-sm font-semibold shadow-inner">
        🚀 Atendimento Rápido | 🚚 Delivery & 🛍️ Retirada no Local | 📞 (81) 9 9370-1785
    </section>

    <!-- Main Container -->
    <main class="max-w-4xl mx-auto px-4 py-6 w-full flex-grow">
        
        <!-- Categorias -->
        <div class="flex border-b border-gray-300 mb-6 bg-white rounded-t-lg shadow-sm">
            <button onclick="filterCategory('tradicional')" id="tab-tradicional" class="flex-1 py-3 text-center text-gray-600 font-semibold active-tab hover:text-red-600">
                🍕 Tradicionais
            </button>
            <button onclick="filterCategory('especial')" id="tab-especial" class="flex-1 py-3 text-center text-gray-600 font-semibold hover:text-red-600">
                ⭐ Especiais
            </button>
            <button onclick="filterCategory('doce')" id="tab-doce" class="flex-1 py-3 text-center text-gray-600 font-semibold hover:text-red-600">
                🍫 Doces
            </button>
        </div>

        <!-- Lista de Produtos -->
        <div id="pizza-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Renderizado via JS -->
        </div>
    </main>

    <!-- Modal Modal de Seleção de Opções -->
    <div id="options-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
            <button onclick="closeOptionsModal()" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            
            <h2 id="modal-pizza-title" class="text-xl font-bold text-gray-800 mb-1"></h2>
            <p id="modal-pizza-desc" class="text-sm text-gray-500 mb-4"></p>

            <!-- Tamanho -->
            <div class="mb-4">
                <label class="block text-sm font-bold text-gray-700 mb-2">Escolha o Tamanho:</label>
                <div class="grid grid-cols-3 gap-2">
                    <button onclick="selectSize('P')" id="btn-size-P" class="size-btn border p-2 rounded-lg text-center font-semibold text-sm">
                        P (4 fat.)<br><span id="price-P" class="text-xs text-red-600"></span>
                    </button>
                    <button onclick="selectSize('M')" id="btn-size-M" class="size-btn border p-2 rounded-lg text-center font-semibold text-sm">
                        M (6 fat.)<br><span id="price-M" class="text-xs text-red-600"></span>
                    </button>
                    <button onclick="selectSize('G')" id="btn-size-G" class="size-btn border p-2 rounded-lg text-center font-semibold text-sm">
                        G (8 fat.)<br><span id="price-G" class="text-xs text-red-600"></span>
                    </button>
                </div>
            </div>

            <!-- Borda -->
            <div class="mb-4">
                <label class="block text-sm font-bold text-gray-700 mb-2">Borda Recheada (+R$ 5,00):</label>
                <select id="border-select" class="w-full border rounded-lg p-2 text-sm">
                    <option value="Sem Borda">Sem Borda Recheada</option>
                    <option value="Catupiry">Catupiry (+ R$ 5,00)</option>
                    <option value="Cheddar">Cheddar (+ R$ 5,00)</option>
                    <option value="Chocolate">Chocolate (+ R$ 5,00)</option>
                </select>
            </div>

            <!-- Observação -->
            <div class="mb-6">
                <label class="block text-sm font-bold text-gray-700 mb-1">Observação:</label>
                <input type="text" id="obs-input" placeholder="Ex: Tirar cebola, caprichar no orégano..." class="w-full border rounded-lg p-2 text-sm">
            </div>

            <button onclick="confirmAddToCart()" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg shadow transition">
                Adicionar ao Carrinho
            </button>
        </div>
    </div>

    <!-- Modal do Carrinho / Checkout -->
    <div id="cart-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeCart()" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            
            <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2"><i class="fa-solid fa-basket-shopping text-red-600"></i> Seu Pedido</h2>

            <div id="cart-items" class="divide-y mb-4">
                <!-- Itens -->
            </div>

            <!-- Total -->
            <div class="flex justify-between items-center text-lg font-bold border-t border-b py-3 mb-4">
                <span>Total:</span>
                <span id="cart-total" class="text-red-600">R$ 0,00</span>
            </div>

            <!-- Formulário de Finalização -->
            <form id="checkout-form" onsubmit="sendWhatsApp(event)">
                <div class="mb-3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Seu Nome *</label>
                    <input type="text" id="client-name" required class="w-full border rounded-lg p-2 text-sm" placeholder="Digite seu nome">
                </div>

                <!-- Tipo de Entrega -->
                <div class="mb-3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Forma de Envio *</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-1 text-sm">
                            <input type="radio" name="delivery_type" value="Entrega" checked onclick="toggleAddress(true)"> 🚚 Entrega
                        </label>
                        <label class="flex items-center gap-1 text-sm">
                            <input type="radio" name="delivery_type" value="Retirada" onclick="toggleAddress(false)"> 🛍️ Retirada no Local
                        </label>
                    </div>
                </div>

                <div id="address-block" class="mb-3">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Endereço de Entrega *</label>
                    <textarea id="client-address" class="w-full border rounded-lg p-2 text-sm" rows="2" placeholder="Rua, Número, Bairro e Ponto de Referência"></textarea>
                </div>

                <!-- Forma de Pagamento -->
                <div class="mb-4">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Forma de Pagamento *</label>
                    <select id="payment-method" required class="w-full border rounded-lg p-2 text-sm">
                        <option value="Pix">Pix</option>
                        <option value="Cartão de Crédito/Débito">Cartão de Crédito/Débito</option>
                        <option value="Dinheiro">Dinheiro</option>
                    </select>
                </div>

                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-lg shadow flex items-center justify-center gap-2 transition">
                    <i class="fa-brands fa-whatsapp text-xl"></i> Enviar Pedido via WhatsApp
                </button>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-gray-300 py-6 text-center text-sm mt-8">
        <p class="font-bold text-white mb-1">Pizzaria Acelerado</p>
        <p>Rua Mestre Vitalino, 273 - Alto do Moura, Caruaru - PE</p>
        <p class="text-xs text-gray-500 mt-2">© 2026 Pizzaria Acelerado. Todos os direitos reservados.</p>
    </footer>

    <!-- Lógica em JavaScript -->
    <script>
        const WHATSAPP_NUMBER = "5581993701785";

        const prices = {
            tradicional: { P: 18.00, M: 25.00, G: 30.00 },
            especial:    { P: 22.00, M: 28.00, G: 35.00 },
            doce:        { P: 20.00, M: 26.00, G: 32.00 }
        };

        const pizzas = [
            // Tradicionais
            { id: 1, name: "Calabresa", desc: "Molho, muçarela, calabresa fatiada, cebola e orégano", category: "tradicional" },
            { id: 2, name: "Mussarela", desc: "Molho, muçarela abundante, rodelas de tomate e orégano", category: "tradicional" },
            { id: 3, name: "Marguerita", desc: "Molho, muçarela, tomate, manjericão fresco e orégano", category: "tradicional" },
            { id: 4, name: "Frango com Catupiry", desc: "Molho, frango desfiado temperado, catupiry e orégano", category: "tradicional" },
            
            // Especiais
            { id: 5, name: "Português", desc: "Molho, muçarela, presunto, ovo, cebola, pimentão e azeitonas", category: "especial" },
            { id: 6, name: "Carne de Sol", desc: "Molho, muçarela, carne de sol desfiada, queijo coalho e cebola roxa", category: "especial" },
            { id: 7, name: "Acelerado Especial", desc: "Molho, muçarela, calabresa, frango, bacon, catupiry e milho", category: "especial" },
            { id: 8, name: "Bacon Crocante", desc: "Molho, muçarela, bacon em cubos crocantes e milho verde", category: "especial" },

            // Doces
            { id: 9, name: "Chocolate com Morango", desc: "Creme de chocolate ao leite e morangos fatiados", category: "doce" },
            { id: 10, name: "Prestígio", desc: "Chocolate ao leite coberto com coco ralado", category: "doce" },
            { id: 11, name: "Romeu e Julieta", desc: "Muçarela especial com goiabada cremosa", category: "doce" }
        ];

        let currentCategory = 'tradicional';
        let selectedPizza = null;
        let selectedSize = 'G';
        let cart = [];

        function renderPizzas() {
            const container = document.getElementById('pizza-list');
            container.innerHTML = '';

            const filtered = pizzas.filter(p => p.category === currentCategory);

            filtered.forEach(pizza => {
                const pPrice = prices[pizza.category].P;
                const mPrice = prices[pizza.category].M;
                const gPrice = prices[pizza.category].G;

                container.innerHTML += `
                    <div class="bg-white rounded-lg p-4 shadow-sm border flex flex-col justify-between hover:shadow-md transition">
                        <div>
                            <h3 class="font-bold text-lg text-gray-800">${pizza.name}</h3>
                            <p class="text-sm text-gray-600 mt-1">${pizza.desc}</p>
                            <div class="mt-3 text-xs font-semibold text-gray-500">
                                P: <span class="text-red-600 font-bold">R$ ${pPrice.toFixed(2)}</span> | 
                                M: <span class="text-red-600 font-bold">R$ ${mPrice.toFixed(2)}</span> | 
                                G: <span class="text-red-600 font-bold">R$ ${gPrice.toFixed(2)}</span>
                            </div>
                        </div>
                        <button onclick="openOptionsModal(${pizza.id})" class="mt-4 bg-red-600 hover:bg-red-700 text-white font-bold py-2 rounded-lg text-sm transition">
                            Montar Pizza
                        </button>
                    </div>
                `;
            });
        }

        function filterCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.active-tab').forEach(el => el.classList.remove('active-tab'));
            document.getElementById(`tab-${cat}`).classList.add('active-tab');
            renderPizzas();
        }

        function openOptionsModal(id) {
            selectedPizza = pizzas.find(p => p.id === id);
            document.getElementById('modal-pizza-title').innerText = selectedPizza.name;
            document.getElementById('modal-pizza-desc').innerText = selectedPizza.desc;

            const catPrices = prices[selectedPizza.category];
            document.getElementById('price-P').innerText = `R$ ${catPrices.P.toFixed(2)}`;
            document.getElementById('price-M').innerText = `R$ ${catPrices.M.toFixed(2)}`;
            document.getElementById('price-G').innerText = `R$ ${catPrices.G.toFixed(2)}`;

            selectSize('G');
            document.getElementById('border-select').value = "Sem Borda";
            document.getElementById('obs-input').value = "";
            document.getElementById('options-modal').classList.remove('hidden');
        }

        function closeOptionsModal() {
            document.getElementById('options-modal').classList.add('hidden');
        }

        function selectSize(size) {
            selectedSize = size;
            document.querySelectorAll('.size-btn').forEach(btn => btn.classList.remove('border-red-600', 'bg-red-50', 'text-red-600'));
            const activeBtn = document.getElementById(`btn-size-${size}`);
            activeBtn.classList.add('border-red-600', 'bg-red-50', 'text-red-600');
        }

        function confirmAddToCart() {
            const border = document.getElementById('border-select').value;
            const obs = document.getElementById('obs-input').value.trim();
            const basePrice = prices[selectedPizza.category][selectedSize];
            const borderPrice = border !== "Sem Borda" ? 5.00 : 0.00;
            const finalPrice = basePrice + borderPrice;

            cart.push({
                name: selectedPizza.name,
                size: selectedSize,
                border: border,
                obs: obs,
                price: finalPrice
            });

            updateCartUI();
            closeOptionsModal();
        }

        function updateCartUI() {
            document.getElementById('cart-count').innerText = cart.length;
            const itemsContainer = document.getElementById('cart-items');
            itemsContainer.innerHTML = '';

            let total = 0;

            cart.forEach((item, index) => {
                total += item.price;
                itemsContainer.innerHTML += `
                    <div class="py-3 flex justify-between items-center">
                        <div>
                            <p class="font-bold text-gray-800">${item.name} (${item.size})</p>
                            <p class="text-xs text-gray-500">Borda: ${item.border}</p>
                            ${item.obs ? `<p class="text-xs text-amber-600 italic">Obs: ${item.obs}</p>` : ''}
                            <p class="text-sm font-semibold text-red-600">R$ ${item.price.toFixed(2)}</p>
                        </div>
                        <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 text-sm font-bold">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
            });

            document.getElementById('cart-total').innerText = `R$ ${total.toFixed(2)}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function openCart() {
            if (cart.length === 0) {
                alert("Seu carrinho está vazio!");
                return;
            }
            document.getElementById('cart-modal').classList.remove('hidden');
        }

        function closeCart() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        function toggleAddress(show) {
            const addressBlock = document.getElementById('address-block');
            const addressInput = document.getElementById('client-address');
            if (show) {
                addressBlock.classList.remove('hidden');
                addressInput.setAttribute('required', 'required');
            } else {
                addressBlock.classList.add('hidden');
                addressInput.removeAttribute('required');
            }
        }

        function sendWhatsApp(e) {
            e.preventDefault();

            const name = document.getElementById('client-name').value;
            const deliveryType = document.querySelector('input[name="delivery_type"]:checked').value;
            const address = document.getElementById('client-address').value;
            const payment = document.getElementById('payment-method').value;

            let msg = `*--- NOVO PEDIDO: PIZZARIA ACELERADO ---*\n\n`;
            msg += `👤 *Cliente:* ${name}\n`;
            msg += `🚚 *Tipo:* ${deliveryType}\n`;
            if (deliveryType === "Entrega") {
                msg += `📍 *Endereço:* ${address}\n`;
            }
            msg += `💳 *Pagamento:* ${payment}\n\n`;

            msg += `*ITENS DO PEDIDO:*\n`;
            let total = 0;
            cart.forEach((item, i) => {
                total += item.price;
                msg += `${i + 1}. *${item.name}* (Tamanho ${item.size})\n`;
                msg += `   - Borda: ${item.border}\n`;
                if (item.obs) msg += `   - Obs: ${item.obs}\n`;
                msg += `   - Valor: R$ ${item.price.toFixed(2)}\n\n`;
            });

            msg += `*TOTAL:* R$ ${total.toFixed(2)}\n\n`;
            msg += `_Rua Mestre Vitalino, 273 - Alto do Moura, Caruaru - PE_`;

            const encodedMsg = encodeURIComponent(msg);
            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMsg}`, '_blank');
        }

        // Render inicial
        renderPizzas();
    </script>
</body>
</html>
